# Create a key in Nebius Token Factory, then paste it into .env locally.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Explicitly opt in. Local-only testing can use a per-process request cap (1–20).
FIRSTSTEP_LIVE_COACHING=false
FIRSTSTEP_COACH_REQUEST_LIMIT=0
# Hosted coaching additionally requires the persistent ledger in db/001-firststep-budget.sql.
# Store this connection string only in server secrets. Do not use a VITE_ prefix.
FIRSTSTEP_BUDGET_DATABASE_URL=

# Optional local-only draft PR export. Sign in with gh auth login.
# Set one allowed repository, for example owner/repository. Disabled in hosted mode.
ACCESSFIX_GITHUB_REPO=
# For unattended local use, supply ACCESSFIX_GITHUB_TOKEN in the process environment.
